# nnn (Gucixdev fork) - lean build: make [O_FLAG=1 ...], make install, make clean
# Release engineering (static/musl builds, signing, uploads, desktop files, user patches) was removed on purpose.

VERSION = $(shell grep -m1 VERSION $(SRC) | cut -f 2 -d'"')

PREFIX ?= /usr/local
MANPREFIX ?= $(PREFIX)/share/man
STRIP ?= strip
PKG_CONFIG ?= pkg-config
INSTALL ?= install

CFLAGS_OPTIMIZATION ?= -O2

O_DEBUG := 0  # debug binary
O_NORL := 1  # no readline support
O_PCRE2 := 0  # link with PCRE2 library
O_NOLC := 0  # no locale support
O_NOMOUSE := 0  # no mouse support
O_NOBATCH := 0  # no built-in batch renamer
O_NOFIFO := 0  # no FIFO previewer support
O_ICONS := 0  # support icons-in-terminal
O_NERD := 0  # support icons-nerdfont
O_EMOJI := 0  # support emoji
O_QSORT := 0  # use Alexey Tourbin's QSORT implementation
O_BENCH := 0  # benchmark mode (stops at first user input)
O_NOSSN := 0  # disable session support
O_NOUG := 0  # disable user, group name in status bar
O_NOX11 := 0  # disable X11 integration
O_NOSORT := 0  # disable sorting entries on dir load
O_DIMFILTERED := 1  # dim characters matching filter (default: enabled)
O_NOBRAILLE := 0  # braille support enabled by default

# options that only need a -D: $(call flag,MAKE_OPTION,C_MACRO)
flag = $(if $(filter 1,$(strip $($(1)))),$(eval CPPFLAGS += -D$(2)))
$(call flag,O_DEBUG,DEBUG)
$(call flag,O_NORL,NORL)
$(call flag,O_PCRE2,PCRE2)
$(call flag,O_NOMOUSE,NOMOUSE)
$(call flag,O_NOBATCH,NOBATCH)
$(call flag,O_NOFIFO,NOFIFO)
$(call flag,O_QSORT,TOURBIN_QSORT)
$(call flag,O_BENCH,BENCH)
$(call flag,O_NOSSN,NOSSN)
$(call flag,O_NOUG,NOUG)
$(call flag,O_NOX11,NOX11)
$(call flag,O_NOSORT,NOSORT)
$(call flag,O_DIMFILTERED,DIM_FILTERED)
$(call flag,O_NOBRAILLE,NOBRAILLE)

ifeq ($(strip $(O_DEBUG)),1)
	CFLAGS += -g3
endif

ifneq ($(strip $(O_NORL)),1)
	LDLIBS += -lreadline
endif
ifeq ($(strip $(O_PCRE2)),1)
	LDLIBS += -lpcre2-8
endif

# icons: exactly one of O_ICONS / O_NERD / O_EMOJI; they need the wide-char locale support (O_NOLC is ignored)
ICON_SETS := $(strip $(filter 1,$(strip $(O_ICONS)) $(strip $(O_NERD)) $(strip $(O_EMOJI))))
ifneq ($(words $(ICON_SETS)),0)
ifneq ($(words $(ICON_SETS)),1)
$(error Choose only one system for icons (O_ICONS, O_NERD or O_EMOJI))
endif
endif
ifeq ($(strip $(O_ICONS)),1)
	ICONS_INCLUDE = icons-generated-icons-in-term.h
	CPPFLAGS += -DICONS_IN_TERM
endif
ifeq ($(strip $(O_NERD)),1)
	ICONS_INCLUDE = icons-generated-nerd.h
	CPPFLAGS += -DNERD
endif
ifeq ($(strip $(O_EMOJI)),1)
	ICONS_INCLUDE = icons-generated-emoji.h
	CPPFLAGS += -DEMOJI
endif
ifdef ICONS_INCLUDE
	CPPFLAGS += -DICONS_INCLUDE=\"$(ICONS_INCLUDE)\"
	HEADERS += src/icons.h src/$(ICONS_INCLUDE) src/icons-in-terminal.h
else ifeq ($(strip $(O_NOLC)),1)
	CPPFLAGS += -DNOLC
endif

ifeq ($(shell $(PKG_CONFIG) ncursesw && echo 1),1)
	CFLAGS_CURSES ?= $(shell $(PKG_CONFIG) --cflags ncursesw)
	LDLIBS_CURSES ?= $(shell $(PKG_CONFIG) --libs   ncursesw)
else ifeq ($(shell $(PKG_CONFIG) ncurses && echo 1),1)
	CFLAGS_CURSES ?= $(shell $(PKG_CONFIG) --cflags ncurses)
	LDLIBS_CURSES ?= $(shell $(PKG_CONFIG) --libs   ncurses)
else
	LDLIBS_CURSES ?= -lncurses
endif

CFLAGS += -std=c11 -Wall -Wextra -Wshadow $(CFLAGS_OPTIMIZATION) $(CFLAGS_CURSES)
LDLIBS += $(LDLIBS_CURSES) -lpthread

SRC = src/nnn.c
HEADERS += src/nnn.h $(if $(filter 1,$(strip $(O_DEBUG))),src/dbg.h) $(if $(filter 1,$(strip $(O_QSORT))),src/qsort.h)
BIN = nnn

all: $(BIN)

$(BIN): $(SRC) $(HEADERS) Makefile
	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)

# the icon tables are generated by a small host program
HOST_CC ?= $(CC)
src/$(ICONS_INCLUDE): src/icons-hash.c src/icons.h src/icons-in-terminal.h
	$(HOST_CC) $(CFLAGS) $(CPPFLAGS) -DICONS_GENERATE -o src/icons-hash-gen src/icons-hash.c
	./src/icons-hash-gen > $@

strip: $(BIN)
	$(STRIP) $^

install: strip
	$(INSTALL) -m 0755 -d $(DESTDIR)$(PREFIX)/bin $(DESTDIR)$(MANPREFIX)/man1
	$(INSTALL) -m 0755 $(BIN) $(DESTDIR)$(PREFIX)/bin
	$(INSTALL) -m 0644 $(BIN).1 $(DESTDIR)$(MANPREFIX)/man1

uninstall:
	$(RM) $(DESTDIR)$(PREFIX)/bin/$(BIN) $(DESTDIR)$(MANPREFIX)/man1/$(BIN).1

clean:
	$(RM) $(BIN) src/icons-hash-gen src/icons-generated-*.h

.PHONY: all strip install uninstall clean
