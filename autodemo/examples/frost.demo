# frost editor: open a file in a private HOME and edit it
size 100x28
theme dark
title "frost"
setup mkdir -p $HOME/w && printf 'fn main() {\n    println!("hello");\n}\n' > $HOME/w/hello.rs
cd /tmp
run /data/dev/github/frost/target/release/frost $HOME/w/hello.rs
wait 1s
caption "frost - a small Rust editor" bottom
key Down Down
wait 500ms
type "// typed by autodemo" 60
key Escape
wait 1500ms
