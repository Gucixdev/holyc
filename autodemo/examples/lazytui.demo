# lazytui gallery (holyc/lazytui) - mouse + keys, private HOME
size 110x34
theme dracula
title "lazytui demo"
slide "lazytui" "a tiny C TUI toolkit" 1500ms
run /data/dev/github/holyc/lazytui/examples/demo
wait 1500ms
caption "Widgets driven by data + events" bottom
cursor move 10 5 700ms
wait 800ms
key Tab
wait 1s
key Tab
wait 1s
caption "Mouse works too" top
cursor move 30 12 600ms
cursor click
wait 800ms
key q
wait 300ms
