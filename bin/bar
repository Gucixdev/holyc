#!/usr/bin/env bash
# bar - turn dwl's stdout into lemonbar lines.
# Use: dwl -s 'bar | lemonbar -p' . dwl prints, per output: "<out> tags <occ> <seltags> <sel> <urg>", "<out> layout <sym>",
# "<out> selmon 0|1" and one "<out> client <tags> <floating> <focused> <fullscreen> <appid>" per window, closed by "<out> clients-end".
# Left: tags, layout NAME, then the windows on the visible tags (focused one highlighted, ~ floating, * fullscreen).
# Right: outputs (focused one highlighted), cpu, gpu (nvidia-smi, cached), ram, swap, volume, battery, clock.
# Every output gets its own segment (%{Sn<name>}); the output list on the right marks the output the segment belongs to.
set -u
declare -A OCC LAY SELMON CL NEWCL
FOC='%{B#458588}%{F#ebdbb2}' NOR='%{B-}%{F-}' DIM='%{F#928374}' ACC='%{F#fabd2f}'

lname() {   # layout symbol -> name (symbols come from config.h)
	case $1 in
		'[]=') echo tile ;; '><>') echo float ;; '[M]') echo tabbed ;; '[D]') echo stack ;; 'HHH') echo grid ;; *) echo "$1" ;;
	esac
}

# stats refresh at most every 2 s so a burst of dwl events does not fork a pile of processes
last=0 prev_total=0 prev_idle=0 cpu=0 mem='' swp='' gpu='' vol='' bat=''
stats() {
	(( EPOCHSECONDS - last < 2 )) && return
	last=$EPOCHSECONDS
	local _ u n s idle rest total k v mt=0 ma=0 st=0 sf=0
	read -r _ u n s idle rest < /proc/stat
	total=$((u + n + s + idle + ${rest%% *}))
	(( total > prev_total )) && cpu=$(( 100 * ( (total - prev_total) - (idle - prev_idle) ) / (total - prev_total) ))
	prev_total=$total prev_idle=$idle
	while read -r k v _; do
		case $k in MemTotal:) mt=$v ;; MemAvailable:) ma=$v ;; SwapTotal:) st=$v ;; SwapFree:) sf=$v ;; esac
	done < /proc/meminfo
	mem="$(( (mt - ma) / 1024 ))M" swp="$(( (st - sf) / 1024 ))M"
	if command -v nvidia-smi >/dev/null; then
		gpu=$(nvidia-smi --query-gpu=utilization.gpu,memory.used,temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1 | awk -F', *' '{printf "%s%% %sM %sC", $1, $2, $3}')
	fi
	vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d%%", $2*100}')
	bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
}

seg() {   # one output's segment: its own tags, layout and windows on the left, output list and stats on the right
	local f=$1 o outs='' i m tags='' tasks='' ent a fl fo fsc app lay occ seltags
	occ=${OCC[$f]%% *} seltags=${OCC[$f]#* }
	for i in 1 2 3 4 5 6 7 8 9; do
		m=$((1 << (i - 1)))
		if   (( seltags & m )); then tags+="${FOC} $i ${NOR}"
		elif (( occ & m ));     then tags+="${ACC} $i ${NOR}"
		else                         tags+="${DIM} $i ${NOR}"
		fi
	done
	while IFS= read -r ent; do   # "<tags> <floating> <focused> <fullscreen> <appid>"
		[ -z "$ent" ] && continue
		set -- $ent; a=$1 fl=$2 fo=$3 fsc=$4 app=${5:-?}
		(( a & seltags )) || continue
		app=${app##*.}; app=${app:0:14}; app=${app//%/%%}
		(( fl )) && app="~$app"
		(( fsc )) && app="*$app"
		if (( fo )); then tasks+="${FOC} $app ${NOR}"; else tasks+="${DIM} $app ${NOR}"; fi
	done <<< "${CL[$f]:-}"
	lay=$(lname "${LAY[$f]:-}")
	for o in "${!OCC[@]}"; do
		if [ "$o" = "$f" ]; then outs+="${FOC} $o ${NOR}"; else outs+="${DIM} $o ${NOR}"; fi
	done
	printf '%%{Sn%s}%%{l}%s %s%s%s %s%%{r}%s cpu %s%% | gpu %s | ram %s swap %s | %s%s%s ' \
		"$f" "$tags" "$ACC" "$lay" "$NOR" "$tasks" "$outs" "$cpu" "${gpu:--}" "$mem" "$swp" \
		"${vol:+vol $vol | }" "${bat:+bat $bat% | }" "$(date '+%a %d %b %H:%M')"
}

render() {   # lemonbar draws on the first monitor only unless told: %{Sn<name>} per output
	stats
	local o line=''
	for o in "${!OCC[@]}"; do line+=$(seg "$o"); done
	[ -n "$line" ] && printf '%s\n' "$line"
}

while true; do
	if IFS= read -r -t 2 line; then
		set -- $line
		o=${1:-}
		case ${2:-} in
			tags)        OCC[$o]="${3:-0} ${4:-1}" ;;
			layout)      LAY[$o]=${3:-} ;;
			selmon)      SELMON[$o]=${3:-0} ;;
			client)      NEWCL[$o]+="${line#* client }"$'\n'; continue ;;
			clients-end) CL[$o]=${NEWCL[$o]:-}; NEWCL[$o]=''; continue ;;
			*) continue ;;
		esac
	else
		[ $? -gt 128 ] || exit 0   # timeout (>128) -> redraw for the stats, EOF -> dwl is gone
	fi
	render
done
