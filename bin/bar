#!/usr/bin/env bash
# bar - turn dwl's stdout into lemonbar lines: tags, layout, title, then battery, volume, net, clock.
# Use: dwl -s 'bar | lemonbar -p' ; dwl prints "<output> tags <occ> <seltags> <sel> <urg>", "<output> layout X", "<output> title T".
# Tags are tag1..tag9 as bit masks. No colours here: lemonbar defaults (-B/-F) decide.
set -u
tags=0 sel=0 urg=0 layout='[]=' title=''
status() {
	local bat vol net
	bat=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
	vol=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{printf "%d%%", $2*100}')
	net=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="dev"){print $(i+1); exit}}')
	printf '%s%s%s %s' "${bat:+bat $bat%  }" "${vol:+vol $vol  }" "${net:+$net  }" "$(date '+%a %d %b %H:%M')"
}
render() {
	local i out='' m
	for i in 1 2 3 4 5 6 7 8 9; do
		m=$((1 << (i - 1)))
		if   (( seltags & m )); then out+="[$i]"
		elif (( occ & m ));    then out+=" $i*"
		else                        out+=" $i "
		fi
	done
	printf '%s  %s  %s%%{r}%s\n' "$out" "$layout" "$title" "$(status)"
}
occ=0 seltags=1
render
# one line in, one line out; a timer keeps the clock moving even when dwl is quiet
while true; do
	if IFS= read -r -t 30 line; then
		set -- $line
		case ${2:-} in
			tags)   occ=${3:-0} seltags=${4:-1} sel=${5:-0} urg=${6:-0} ;;
			layout) layout=${3:-} ;;
			title)  title=${line#* title }; title=${title:0:80}; title=${title//%/%%} ;;
			*) continue ;;
		esac
	else
		[ $? -gt 128 ] || exit 0   # timeout (>128) -> redraw, EOF -> dwl is gone
	fi
	render
done
