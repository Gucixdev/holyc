#!/usr/bin/env bash
# all - run every test script. Uses ../bin/colorado (built by ../run). Each script prints its own counts and exits non-zero on failure.
set -u
cd "$(dirname "$(readlink -f "$0")")" || exit 1
export BIN=${BIN:-$PWD/../bin/colorado}
[ -x "$BIN" ] || { echo "all: $BIN missing, run ../run" >&2; exit 1; }
fail=0
for t in unit golden apply set image verify tui; do
	echo "== $t"
	./$t || { echo "!! $t FAILED"; fail=1; }
done
[ $fail = 0 ] && echo "ALL TESTS PASSED" || echo "SOME TESTS FAILED"
exit $fail
