windows.debug.x86_64 = "res://addons/toolbox/tools/ecs/bin/libecs_gdext.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/toolbox/tools/ecs/bin/libecs_gdext.windows.template_release.x86_64.dll"
