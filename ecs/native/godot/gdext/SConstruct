#!/usr/bin/env python
# Builds libecs_gdext.so: this binding's own src/*.cpp plus the ECS core's plain-C src/*.c,
# compiled fresh together (the prebuilt ../../libecs.a isn't built -fPIC, so it can't be
# linked into a shared library - recompiling the dozen .c files here instead of maintaining a
# second, PIC build of the same core is the simpler one-build-config choice for now).

env = SConscript("../godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/", "../../include/"])
sources = Glob("src/*.cpp") + Glob("../../src/*.c")

library = env.SharedLibrary(
    "bin/libecs_gdext{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

Default(library)
