#!/bin/sh
# gtop tests: builds nothing, runs ./gtop --snapshot against the live system.
cd "$(dirname "$0")/.." || exit 1
BIN=./gtop
[ -x "$BIN" ] || { echo "build first: make"; exit 1; }
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT INT TERM
pass=0; fail=0
ok()  { pass=$((pass + 1)); }
bad() { fail=$((fail + 1)); echo "FAIL $1"; }
has() { # name text pattern
	printf '%s\n' "$2" | grep -q -- "$3" && ok || bad "$1 (no '$3')"
}

$BIN --help | grep -q usage && ok || bad "--help"
$BIN --bogus >/dev/null 2>&1; [ $? -eq 2 ] && ok || bad "unknown option exits 2"
$BIN </dev/null >/dev/null 2>&1; [ $? -eq 1 ] && ok || bad "no terminal exits 1"

S=$($BIN --snapshot 130 40)
for w in CPU RAM DISK NET "PROC \[clean\]" NAME "CPU%" ACTIVITY; do has "frame has $w" "$S" "$w"; done
[ "$(printf '%s\n' "$S" | wc -l)" -eq 40 ] && ok || bad "frame has 40 lines"
S=$($BIN --snapshot 60 20); has "small terminal" "$S" PROC
S=$($BIN --snapshot 30 12); has "tiny terminal does not crash" "$S" CPU

S=$($BIN --snapshot 130 40 --keys R);  has "raw view lists [pid]" "$S" '\[[0-9][0-9]*\]'
S=$($BIN --snapshot 130 40 --keys L);  has "left switches to the raw view" "$S" "PROC \[raw\]"
S=$($BIN --snapshot 130 40 --keys LL); has "two switches come back to clean" "$S" "PROC \[clean\]"
S=$($BIN --snapshot 200 70 -f kthreadd); printf "%s\n" "$S" | grep -q "kthreadd" && bad "clean view hides kernel threads" || ok
S=$($BIN --snapshot 200 70 -f kthreadd --keys R); has "raw view shows kernel threads" "$S" "kthreadd \[2\]"
S=$($BIN --snapshot 130 40 --keys a);  has "anonymous hides addresses" "$S" "hidden - anonymous mode"
S=$($BIN --snapshot 130 40 -f systemd --keys a);  has "anonymous indicator" "$S" "anonymous mode - IPs and disk model"
S=$($BIN --snapshot 130 40 --keys '+++'); has "interval keys" "$S" "refresh 1300ms"
S=$($BIN --snapshot 130 40 --keys '/');   has "palette opens" "$S" "command (Enter: run, Esc: cancel)"

# kill: a uniquely named sleeper (comm is at most 15 chars)
V="gtv$$"; ln -s /bin/sleep "$T/$V"; "$T/$V" 60 & P=$!
sleep 0.2
S=$($BIN --snapshot 130 40 -f "$V" --keys ' k')
has "kill message" "$S" "killed 1/1"
wait $P 2>/dev/null; [ $? -eq 137 ] && ok || bad "process got SIGKILL"
# filter really filters
"$T/$V" 60 & P=$!; sleep 0.2
S=$($BIN --snapshot 130 40 -f "$V")
[ "$(printf '%s\n' "$S" | grep -c "$V")" -ge 1 ] && ok || bad "filter shows the process"
kill $P 2>/dev/null; wait $P 2>/dev/null


# process tree: several processes of one program are one row with its processes always shown below it
"$T/$V" 60 & P1=$!; "$T/$V" 60 & P2=$!; "$T/$V" 60 & P3=$!
sleep 0.2
S=$($BIN --snapshot 130 40 -f "$V");        has "program row shows the count" "$S" "$V (3)"
has "the tree is always open" "$S" "├── $V \\["
has "last child uses the corner" "$S" "└── $V \\["
has "user section divider" "$S" "── user ──"
S=$($BIN --snapshot 130 40 -f "$V" --keys E); has "Enter changes nothing, the tree stays open" "$S" "├── $V \\["
S=$($BIN --snapshot 130 40 -f systemd); has "system section divider" "$S" "── system ──"
S=$($BIN --snapshot 130 40 -f "$V" --keys Dk)
has "kill on a child row kills one process" "$S" "killed 1/1"
sleep 0.2
alive=0; for p in $P1 $P2 $P3; do kill -0 $p 2>/dev/null && alive=$((alive + 1)); done
# a killed child is a zombie until reaped, so count the ones that report 137
dead=0; for p in $P1 $P2 $P3; do if ! [ -d /proc/$p ] || grep -q '^State:.*Z' /proc/$p/status 2>/dev/null; then dead=$((dead + 1)); fi; done
[ "$dead" -eq 1 ] && ok || bad "exactly one of three processes died (got $dead)"
kill $P1 $P2 $P3 2>/dev/null; wait $P1 $P2 $P3 2>/dev/null
S=$($BIN --snapshot 130 40 --keys E); printf '%s\n' "$S" | grep -q "PROCS" && bad "no PROCS column" || ok

# info panel: what the process under the cursor is
S=$($BIN --snapshot 140 50 -f systemd);               has "info panel is on by default" "$S" "── info ──"
has "info has an about line" "$S" "about  "
has "info has the command line" "$S" "cmd    "
S=$($BIN --snapshot 140 50 -f systemd --keys i);      printf "%s\n" "$S" | grep -q "── info ──" && bad "i hides the panel" || ok
S=$($BIN --snapshot 140 50 -f kthreadd --keys R);     has "kernel thread is explained" "$S" "the parent of every kernel thread"
S=$($BIN --snapshot 140 50 -f systemd --keys a);      has "anonymous hides the command line" "$S" "cmd    \[hidden - anonymous mode\]"

# palette runs commands/<name> with the marked pids as arguments
mkdir "$T/cmds"; printf '#!/bin/sh\necho "args: $*"\n' > "$T/cmds/show"
"$T/$V" 60 & P=$!; sleep 0.2
S=$(GTOP_COMMANDS="$T/cmds" $BIN --snapshot 130 40 -f "$V" --keys '/show hello' )
has "palette text typed" "$S" "show hello"
kill $P 2>/dev/null; wait $P 2>/dev/null
"$T/$V" 60 & P=$!; sleep 0.2
S=$(GTOP_COMMANDS="$T/cmds" $BIN --snapshot 130 40 -f "$V" --keys '/show hello'$(printf 'E'))
has "palette ran the command with extra word and pid" "$S" "show: args: hello $P"
kill $P 2>/dev/null; wait $P 2>/dev/null
S=$($BIN --snapshot 130 40 -f systemd --keys '/nosuchcmdE'); has "unknown command reported" "$S" "no such command"

# record: a CSV with the header is created in the working directory
( cd "$T" && "$OLDPWD/$BIN" --snapshot 100 30 --keys r >/dev/null ) 
ls "$T"/gtop-record-*.csv >/dev/null 2>&1 && ok || bad "record file created"
head -1 "$T"/gtop-record-*.csv 2>/dev/null | grep -q '^unix_ts,cpu_pct' && ok || bad "record header"

echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
