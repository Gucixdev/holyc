/-
  `#audit_axioms Root`: every theorem whose defining module is Root or below it - written in the sources or
  generated by Lean there - may rest on `propext`, `Classical.choice` and `Quot.sound` only: no `sorry`, no
  `native_decide` or `bv_decide` (`Lean.ofReduceBool`, `Lean.trustCompiler`), no axiom of a library. Selecting by
  defining module catches a theorem in any namespace. A project's Audit.lean is three lines:
    import Holyc.Audit
    import Base
    #audit_axioms Base
-/
import Lean

open Lean Elab Command

elab "#audit_axioms " root:ident : command => do
  let env ← getEnv
  let root := root.getId
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count := 0
  let mut written := 0
  let mut bad : Array (Name × Name) := #[]
  for (name, ci) in env.constants.toList do
    let some i := env.getModuleIdxFor? name | continue
    unless root.isPrefixOf env.header.moduleNames[i.toNat]! do continue
    if let .thmInfo _ := ci then
      count := count + 1
      if (← findDeclarationRanges? name).isSome then written := written + 1
      for a in ← liftCoreM (collectAxioms name) do
        unless allowed.contains a do bad := bad.push (name, a)
  if bad.isEmpty then
    logInfo m!"axiom audit: {count} theorems ({written} written in the sources, {count - written} generated by Lean), none rests on more than propext, Classical.choice, Quot.sound"
  else
    throwError m!"axiom audit: {bad.size} theorems rest on other axioms: {bad.toList}"
