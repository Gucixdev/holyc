#!/usr/bin/env bash
# run - build netman and open its terminal UI (no arguments; the CLI is bin/netman: `bin/netman help`, `bin/netman wifi list`, ...).
# Root is asked for by netman itself (sudo password prompt, before the screen is drawn) and only when the backend needs it.
set -eu
cd "$(dirname "$(readlink -f "$0")")" || exit 1
inc=../notcoreutils
[ -f netmanager_blue.h ] && inc=.
mkdir -p bin
if [ ! -x bin/netman ] || [ netman.c -nt bin/netman ] || [ tui.h -nt bin/netman ] || [ priv.h -nt bin/netman ] || [ "$inc/netmanager_blue.h" -nt bin/netman ]; then
	gcc -std=gnu11 -Wall -Wextra -O2 -I"$inc" -I. netman.c -o bin/netman
fi
exec bin/netman -tui
