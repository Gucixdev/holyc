table inet netman_vpn_ks
delete table inet netman_vpn_ks
table inet netman_vpn_ks {
 chain out {
  type filter hook output priority -10; policy drop;
  oifname "lo" accept
  oifname "wg0" accept
  ip daddr 203.0.113.9 udp dport 51820 accept
  ip6 daddr 2001:db8::7 tcp dport 443 accept
  udp sport 68 udp dport 67 accept
  udp sport 546 udp dport 547 accept
  meta l4proto { tcp, udp } th dport { 53, 853 } drop
 }
}
