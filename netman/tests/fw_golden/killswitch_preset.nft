table inet netman
delete table inet netman
table inet netman {
 chain c_pre {
  type filter hook prerouting priority -300; policy accept;
  udp sport 68 udp dport 67 accept
  ip saddr 0.0.0.0 accept
  fib saddr . iif oif missing drop
 }
 chain c_in {
  type filter hook input priority 0; policy drop;
  iifname "lo" accept
  ct state { established, related } accept
  ct state invalid drop
  ct state new limit rate over 200/second burst 400 packets drop
  udp sport 67 udp dport 68 accept comment "dhcp client"
  udp sport 547 udp dport 546 accept comment "dhcpv6 client"
  icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
  icmp type echo-request limit rate 5/second accept
  icmpv6 type echo-request limit rate 5/second accept
 }
 chain c_fwd {
  type filter hook forward priority 0; policy drop;
  ct state { established, related } accept
  ct state invalid drop
 }
 chain c_out {
  type filter hook output priority 0; policy drop;
  oifname "lo" accept
  oifname "wg0" accept comment "killswitch tunnel"
  udp dport { 53, 853 } drop comment "killswitch dns leak"
  tcp dport { 53, 853 } drop comment "killswitch dns leak"
  ip daddr 203.0.113.9 udp dport 51820 accept comment "killswitch endpoint"
  ip6 daddr 2001:db8::7 tcp dport 443 accept comment "killswitch endpoint"
  ct state { established, related } accept
  udp sport 68 udp dport 67 accept comment "dhcp client"
  udp sport 546 udp dport 547 accept comment "dhcpv6 client"
  icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
 }
}
