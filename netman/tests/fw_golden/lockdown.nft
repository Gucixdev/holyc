table inet netman
delete table inet netman
table inet netman {
 chain c_in {
  type filter hook input priority 0; policy drop;
  iifname "lo" accept
  ct state { established, related } accept
  ct state invalid drop
  udp sport 67 udp dport 68 accept comment "dhcp client"
  udp sport 547 udp dport 546 accept comment "dhcpv6 client"
  icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
 }
 chain c_fwd {
  type filter hook forward priority 0; policy drop;
  ct state { established, related } accept
  ct state invalid drop
 }
 chain c_out {
  type filter hook output priority 0; policy accept;
  oifname "lo" accept
 }
}
