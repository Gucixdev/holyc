*filter
:NETMAN - [0:0]
:NETMAN_OUT - [0:0]
:NETMAN_FWD - [0:0]
:NETMAN_LIM - [0:0]
:NETMAN_LIMZ - [0:0]
-A NETMAN -i lo -j ACCEPT
-A NETMAN -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A NETMAN -m conntrack --ctstate INVALID -j DROP
-A NETMAN -i lo0 -j ACCEPT
-A NETMAN -i eth0 -p udp --dport 5353 -j ACCEPT
-A NETMAN -i eth0 -p ipv6-icmp --icmpv6-type echo-request -j ACCEPT
-A NETMAN -i wl0 -p ipv6-icmp --icmpv6-type echo-request -j DROP
-A NETMAN -i wl0 -p ipv6-icmp --icmpv6-type router-advertisement ! -s fe80::1 -j DROP
-A NETMAN -i wl0 -m conntrack --ctstate NEW -j NETMAN_LIMZ
-A NETMAN -i usb+ -p ipv6-icmp --icmpv6-type router-advertisement ! -s fe80::1 -j DROP
-A NETMAN -i usb+ -p udp --sport 547 --dport 546 -j ACCEPT
-A NETMAN -i usb+ -p ipv6-icmp --icmpv6-type router-advertisement -j ACCEPT
-A NETMAN -i usb+ -p ipv6-icmp --icmpv6-type neighbour-solicitation -j ACCEPT
-A NETMAN -i usb+ -p ipv6-icmp --icmpv6-type neighbour-advertisement -j ACCEPT
-A NETMAN -i usb+ -j DROP
-A NETMAN -m conntrack --ctstate NEW -j NETMAN_LIM
-A NETMAN_LIM -m limit --limit 200/second --limit-burst 400 -j RETURN
-A NETMAN_LIM -j DROP
-A NETMAN -p tcp --dport 23 -j LOG --log-prefix "netman: "
-A NETMAN -p tcp --dport 23 -j DROP
-A NETMAN -p udp --sport 547 --dport 546 -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type destination-unreachable -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type packet-too-big -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type time-exceeded -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type parameter-problem -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type router-advertisement -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type neighbour-solicitation -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type neighbour-advertisement -j ACCEPT
-A NETMAN -p ipv6-icmp --icmpv6-type echo-request -m limit --limit 5/second -j ACCEPT
-A NETMAN -j DROP
-A NETMAN_FWD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A NETMAN_FWD -m conntrack --ctstate INVALID -j DROP
-A NETMAN_FWD -i wl0 -o eth0 -m conntrack --ctstate ESTABLISHED,RELATED,NEW -j ACCEPT
-A NETMAN_FWD -j DROP
-A NETMAN_OUT -o wl0 -p tcp -m multiport --dports 135,139,445 -j DROP
-A NETMAN_OUT -o wl0 -p udp -m multiport --dports 137,138,1900,5353 -j DROP
-A NETMAN_OUT -o usb+ -p tcp -m multiport --dports 135,139,445 -j DROP
-A NETMAN_OUT -o usb+ -p udp -m multiport --dports 137,138,1900,5353 -j DROP
-A NETMAN_LIMZ -m limit --limit 30/second --limit-burst 60 -j RETURN
-A NETMAN_LIMZ -j DROP
COMMIT
