table inet netman
delete table inet netman
table inet netman {
 chain c_pre {
  type filter hook prerouting priority -300; policy accept;
  udp sport 68 udp dport 67 accept
  ip saddr 0.0.0.0 accept
  fib saddr . iif oif missing drop
 }
 chain c_in {
  type filter hook input priority 0; policy drop;
  iifname "lo" accept
  ct state { established, related } accept
  ct state invalid drop
  iifname "ap0" udp dport 5353 accept comment "home mdns"
  iifname "ap0" icmp type echo-request accept
  iifname "eth0" icmp type echo-request drop
  iifname "eth0" icmpv6 type echo-request drop
  iifname "eth0" ct state new limit rate over 30/second burst 60 packets drop
  ct state new limit rate over 200/second burst 400 packets drop
  iifname "ap0" udp dport 67 accept comment "share dhcp"
  iifname "ap0" udp dport 53 accept comment "share dns udp"
  iifname "ap0" tcp dport 53 accept comment "share dns tcp"
  udp sport 67 udp dport 68 accept comment "dhcp client"
  udp sport 547 udp dport 546 accept comment "dhcpv6 client"
  icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
  icmp type echo-request limit rate 5/second accept
  icmpv6 type echo-request limit rate 5/second accept
 }
 chain c_fwd {
  type filter hook forward priority 0; policy drop;
  ct state { established, related } accept
  ct state invalid drop
  iifname "ap0" oifname "eth0" accept comment "share"
 }
 chain c_out {
  type filter hook output priority 0; policy accept;
  oifname "lo" accept
  oifname "eth0" tcp dport { 135, 139, 445 } drop comment "no smb on public wifi"
  oifname "eth0" udp dport { 137, 138, 1900, 5353 } drop comment "no netbios/ssdp/mdns on public wifi"
 }
 chain c_post {
  type nat hook postrouting priority 100; policy accept;
  oifname "eth0" masquerade
 }
}
