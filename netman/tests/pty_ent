#!/usr/bin/env bash
# pty_ent - drive the Enterprise tab of the real TUI against REAL bond / bridge / vlan devices inside `unshare -Urn` (user+net namespace:
# nothing outside is touched). Profiles come from a temp dir via NETMAN_CONF_DIR, licences from enterprise.licence_dir. Checks that the tab
# exists only with enterprise.enabled, shows bonds/bridges/vlans/uplinks/licences read-only, I/i details, 80x24 and 40x12.
# Skips (exit 0) when unshare / tmux / bonding are unavailable.
set -u
self=$(readlink -f "$0"); cd "$(dirname "$self")" || exit 1
if [ -z "${NM_PTY_ENT_INNER:-}" ]; then
	command -v tmux >/dev/null && command -v unshare >/dev/null || { echo "pty_ent: skipped (tmux/unshare missing)"; exit 0; }
	unshare -Urn true 2>/dev/null || { echo "pty_ent: skipped (no user namespaces)"; exit 0; }
	NM_PTY_ENT_INNER=1 exec unshare -Urn "$self"
fi
ip link set lo up
ip link add nmb0 type bond mode 802.3ad 2>/dev/null || { echo "pty_ent: skipped (no bonding in this kernel)"; exit 0; }
ip link del nmb0
work=$(mktemp -d); trap 'tmux -L nment kill-server 2>/dev/null; rm -rf "$work"' EXIT
cc -std=gnu11 -Wall -Wextra -O2 -I../src -I../src/mods -o "$work/nm" ../src/netman.c ../src/config.c ../src/mods/enterprise.c ../src/mods/tether.c ../src/mods/licence.c ../src/mods/wireguard.c ../src/mods/vpnmod.c ../src/mods/openvpn.c ../src/mods/ipsec.c ../src/mods/l2tp.c ../src/mods/openconnect.c ../src/mods/sstp.c ../src/mods/vpnimport.c ../src/mods/tor.c || exit 1
mkdir -p "$work/conf" "$work/lic"
chmod 755 "$work"
ip link add dummy0 type dummy; ip link add dummy1 type dummy; ip link set dummy0 up; ip link set dummy1 up
ip link add bond0 type bond mode 802.3ad; ip link set bond0 up
ip link add br0 type bridge; ip link set br0 up
ip link add link dummy0 name dummy0.10 type vlan id 10; ip link set dummy0.10 up
printf 'kind=bond\nname=bond0\nmode=802.3ad\nmember=dummy0\nmember=dummy1\n' >"$work/conf/bond0.ent"
printf 'kind=bond\nname=bondx\nmode=active-backup\nmember=dummy1\n' >"$work/conf/bondx.ent"
printf 'kind=ecmp\nname=wan\nuplink=dummy0,192.0.2.1,192.0.2.1,1\nuplink=dummy1,198.51.100.1,198.51.100.1,3\n' >"$work/conf/wan.ent"
printf 'name=seat\nholder=ACME\nkind=support\nexpires=2099-12-31\nkey=SECRETSECRET\n' >"$work/lic/seat.lic"
printf 'name=old\nholder=ACME\nkind=seat\nexpires=2020-01-01\n' >"$work/lic/old.lic"
printf '[privileges]\nsudo = never\n[wifi]\nenabled = no\n[bluetooth]\nenabled = no\n[vpn]\nenabled = no\n[net]\nenabled = no\n[enterprise]\nenabled = yes\nlicence_dir = %s/lic\n' "$work" >"$work/c.conf"
printf '[privileges]\nsudo = never\n[wifi]\nenabled = no\n[bluetooth]\nenabled = no\n[vpn]\nenabled = no\n[net]\nenabled = yes\n' >"$work/off.conf"
T="tmux -L nment"
pass=0 fail=0
ok() { pass=$((pass + 1)); }
no() { fail=$((fail + 1)); printf 'FAIL: %s\n' "$1"; [ -n "${2:-}" ] && printf '%s\n' "$2" | sed 's/^/      | /'; }
snap() { $T capture-pane -p -t t; }
has() { local s i; for i in $(seq 1 16); do s=$(snap); grep -qF -- "$1" <<<"$s" && { ok; return; }; sleep 0.25; done; no "$2 (wanted '$1')" "$s"; }
hasnt() { local s i; for i in $(seq 1 16); do s=$(snap); grep -qF -- "$1" <<<"$s" || { ok; return; }; sleep 0.25; done; no "$2 (did not want '$1')" "$s"; }
keys() { $T send-keys -t t "$@"; sleep 0.6; }
start() { # cols rows config
	$T kill-server 2>/dev/null
	$T -u new-session -d -s t -x "$1" -y "$2" "NETMAN_CONF_DIR=$work/conf NETMAN_CONFIG=$3 LANG=C.UTF-8 TERM=xterm-256color $work/nm -tui; echo EXIT:\$?; sleep 30"
	sleep 2
}

# --- disabled: no tab at all ---
start 100 26 "$work/off.conf"
has "1 Ethernet" "ethernet tab present"; hasnt "Enterprise" "no Enterprise tab when enterprise.enabled = no"
keys 2
hasnt "wan:dummy0" "key 2 does not open an enterprise tab"
$T kill-server 2>/dev/null
# --- enabled ---
start 100 26 "$work/c.conf"
has "1 Enterprise" "the tab exists (only module on)"
has "bond0" "live bond listed"; has "bondx" "profile whose device is absent listed"; has "absent" "absent state"; has "br0" "live bridge listed (no profile)"
has "dummy0.10" "live vlan listed"; has "vid 10" "vlan id shown"; has "wan:dummy0" "ecmp uplink listed"; has "wan:dummy1" "second uplink"
has "seat" "licence listed"; has "valid" "valid licence"; has "expired" "expired licence flagged"
has "read-only" "read-only hint"
hasnt "SECRETSECRET" "licence key never shown"
keys j; keys i
has "kind" "info popup opens"; has "state" "info popup: state"
keys Escape
keys g; keys I
has "all info" "I opens the all-info view"; has "profile" "all-info: profile"
keys I
hasnt "all info" "I closes it"
keys Enter
hasnt "Traceback" "enter is harmless"
ip link show bondx >/dev/null 2>&1 && no "enter must not create devices (read-only)" || ok
keys /; keys b; keys o; keys n; keys d; keys Enter
has "bond0" "filter keeps bonds"; hasnt "seat" "filter hides licences"
keys Escape
# --- 80x24 and 40x12 ---
for size in "80 24" "40 12"; do
	set -- $size
	start "$1" "$2" "$work/c.conf"
	s=$(snap); w=$(awk '{ if (length($0) > m) m = length($0) } END { print m + 0 }' <<<"$s")
	[ "$w" -le "$1" ] && ok || no "no row wider than $1 at $1x$2" "$s"
	has "bond0" "bond row at $1x$2"; has "q quit" "keybar survives at $1x$2"
	keys i; has "esc close" "info popup at $1x$2"; keys Escape
	keys I
	s=$(snap); w=$(awk '{ if (length($0) > m) m = length($0) } END { print m + 0 }' <<<"$s")
	[ "$w" -le "$1" ] && ok || no "all-info not wider than $1 at $1x$2" "$s"
	keys I; keys q
	has "EXIT:0" "clean exit at $1x$2"
done
echo "pty_ent: $pass ok, $fail failed"
[ "$fail" -eq 0 ]
