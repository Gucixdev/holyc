#!/usr/bin/env bash
# pty_mods - the SSH, Mesh, Bond and Tunnel tabs in the real TUI inside `unshare -Urn` (nothing outside is touched; ssh is never started).
# Checks: each tab exists only when its module is enabled, shows the mod's status rows read-only, 80x24 and 40x12 fit, clean exit.
set -u
self=$(readlink -f "$0"); cd "$(dirname "$self")" || exit 1
if [ -z "${NM_PTY_MODS_INNER:-}" ]; then
	command -v tmux >/dev/null && command -v unshare >/dev/null || { echo "pty_mods: skipped (tmux/unshare missing)"; exit 0; }
	unshare -Urn true 2>/dev/null || { echo "pty_mods: skipped (no user namespaces)"; exit 0; }
	NM_PTY_MODS_INNER=1 exec unshare -Urn "$self"
fi
ip link set lo up
work=$(mktemp -d); trap 'tmux -L nmmods kill-server 2>/dev/null; rm -rf "$work"' EXIT
cc -std=gnu11 -Wall -Wextra -O2 -I../src -I../src/mods -o "$work/nm" ../src/netman.c ../src/config.c ../src/mods/enterprise/enterprise.c ../src/mods/enterprise/tether.c ../src/mods/enterprise/licence.c ../src/mods/wireguard.c ../src/mods/vpnmod.c ../src/mods/openvpn.c ../src/mods/ipsec.c ../src/mods/l2tp.c ../src/mods/openconnect.c ../src/mods/sstp.c ../src/mods/vpnimport.c ../src/mods/tor.c ../src/mods/ssh.c ../src/mods/mesh.c ../src/mods/bonding.c ../src/mods/tunnel.c || exit 1
chmod 755 "$work"; mkdir -p "$work/ssh" "$work/mesh" "$work/tun"
printf 'host = example.org\nuser = me\nport = 2222\n' >"$work/ssh/web.ssh"
printf 'kind = gre\nlocal = 192.0.2.1\nremote = 192.0.2.2\n' >"$work/tun/g1.tun"
printf 'kind = batman\nifaces = eth9\n' >"$work/mesh/lab.mesh"
printf '[privileges]\nsudo = never\n[wifi]\nenabled = no\n[bluetooth]\nenabled = no\n[vpn]\nenabled = no\n[net]\nenabled = yes\n[ssh]\nenabled = yes\ndir = %s/ssh\nstate_dir = %s/st\n[mesh]\nenabled = yes\ndir = %s/mesh\n[bonding]\nenabled = yes\n[tunnel]\nenabled = yes\ndir = %s/tun\n' "$work" "$work" "$work" "$work" >"$work/c.conf"
printf '[privileges]\nsudo = never\n[wifi]\nenabled = no\n[bluetooth]\nenabled = no\n[vpn]\nenabled = no\n[net]\nenabled = yes\n' >"$work/off.conf"
T="tmux -L nmmods"
pass=0 fail=0
ok() { pass=$((pass + 1)); }
no() { fail=$((fail + 1)); printf 'FAIL: %s\n' "$1"; [ -n "${2:-}" ] && printf '%s\n' "$2" | sed 's/^/      | /'; }
snap() { $T capture-pane -p -t t; }
has() { local s i; for i in $(seq 1 16); do s=$(snap); grep -qF -- "$1" <<<"$s" && { ok; return; }; sleep 0.25; done; no "$2 (wanted '$1')" "$s"; }
hasnt() { local s i; for i in $(seq 1 16); do s=$(snap); grep -qF -- "$1" <<<"$s" || { ok; return; }; sleep 0.25; done; no "$2 (did not want '$1')" "$s"; }
keys() { $T send-keys -t t "$@"; sleep 0.6; }
start() { $T kill-server 2>/dev/null; $T -u new-session -d -s t -x "$1" -y "$2" "NETMAN_CONFIG=$3 LANG=C.UTF-8 TERM=xterm-256color $work/nm -tui; echo EXIT:\$?; sleep 30"; sleep 2; }

start 100 26 "$work/off.conf"
has "1 Ethernet" "tabs present"; hasnt "SSH" "no SSH tab when ssh.enabled = no"; hasnt "Tunnel" "no Tunnel tab when tunnel.enabled = no"
start 100 26 "$work/c.conf"
has "SSH" "SSH tab exists"; has "Mesh" "Mesh tab exists"; has "Bond" "Bond tab exists"; has "Tunnel" "Tunnel tab exists"
keys 2; has "web" "ssh profile row"; has "example.org:2222" "ssh endpoint shown"
keys 3; has "lab" "mesh profile row"; has "batman" "mesh kind shown"
keys 4; has "no bonds" "empty bond tab says how to add one"
keys 5; has "g1" "tunnel profile row"; has "gre" "tunnel kind shown"
for size in "80 24" "40 12"; do
	set -- $size
	start "$1" "$2" "$work/c.conf"
	keys 5
	s=$(snap); w=$(awk '{ if (length($0) > m) m = length($0) } END { print m + 0 }' <<<"$s")
	[ "$w" -le "$1" ] && ok || no "no row wider than $1 at $1x$2" "$s"
	has "q quit" "keybar survives at $1x$2"
	keys q; has "EXIT:0" "clean exit at $1x$2"
done
echo "pty_mods: $pass ok, $fail failed"
[ "$fail" -eq 0 ]
