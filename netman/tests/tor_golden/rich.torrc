# generated by netman - rewritten on every `netman tor up`, do not edit
DataDirectory /run/netman/tor/data
PidFile /run/netman/tor/tor.pid
Log notice file /run/netman/tor/tor.log
ClientOnly 1
AvoidDiskWrites 1
SocksPort 127.0.0.1:9050 IsolateDestAddr
TransPort 127.0.0.1:9040 IsolateDestAddr
DNSPort 127.0.0.1:5353
AutomapHostsOnResolve 1
ControlSocket /run/netman/tor/control
CookieAuthentication 1
CookieAuthFile /run/netman/tor/control_auth_cookie
CookieAuthFileGroupReadable 0
UseBridges 1
ClientTransportPlugin obfs4 exec obfs4proxy
ClientTransportPlugin snowflake exec snowflake-client
Bridge obfs4 192.0.2.10:443 0123456789ABCDEF0123456789ABCDEF01234567 cert=abc iat-mode=0
Bridge snowflake 192.0.2.3:80 2B280B23E1107BB62ABFC40DDCC8824814F80A72
ExitNodes {de}
StrictNodes 1
HiddenServiceDir /run/netman/tor/hs/web
HiddenServicePort 80 127.0.0.1:8080
