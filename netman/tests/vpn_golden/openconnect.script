#!/bin/sh
# generated by netman: split tunnel, only these networks go through the VPN (overrides the server's list)
export CISCO_SPLIT_INC_0_ADDR=10.1.0.0 CISCO_SPLIT_INC_0_MASK=255.255.0.0 CISCO_SPLIT_INC_0_MASKLEN=16
export CISCO_IPV6_SPLIT_INC_0_ADDR=2001:db8:: CISCO_IPV6_SPLIT_INC_0_MASKLEN=32
export CISCO_SPLIT_INC=1
export CISCO_IPV6_SPLIT_INC=1
exec /usr/share/vpnc-scripts/vpnc-script "$@"
