#!/usr/bin/env bash
# gen-nmxml - regenerate src/mods/nmapi_xml.h from NetworkManager's own introspection XML (comments/docs stripped, interface blocks only).
# usage: tools/gen-nmxml [REF_DIR]   (default /data/dev/references/networkmanager/introspection)   Output goes to stdout.
set -eu
ref=${1:-/data/dev/references/networkmanager/introspection}
echo "/* nmapi_xml.h - GENERATED by tools/gen-nmxml from NetworkManager's introspection XML (reference: networkmanager 1.58). Do not edit. */"
for pair in Manager: Device:Device Wired:Device.Wired Wireless:Device.Wireless Generic:Device.Generic AccessPoint:AccessPoint \
            Active:Connection.Active Settings:Settings Connection:Settings.Connection IP4:IP4Config IP6:IP6Config Dns:DnsManager Agent:AgentManager; do
	id=${pair%%:*} f=${pair#*:}
	perl -0777 -ne 's/<!--.*?-->//gs; while (/(<interface\b.*?<\/interface>)/gs) { $x = $1; $x =~ s/^[ \t]*\n//mg; $x =~ s/\\/\\\\/g; $x =~ s/"/\\"/g; for (split /\n/, $x) { s/^\s+/ /; print "\t\"$_\\n\"\n" } }' "$ref/org.freedesktop.NetworkManager${f:+.$f}.xml" \
		| { echo "static const char nmx_$id[] ="; cat; echo ";"; }
done
