#!/usr/bin/env bash
# run - build netmanager and open its terminal UI (no arguments; the CLI is bin/netmanager --help-ish: `bin/netmanager wifi list`, ...).
set -eu
cd "$(dirname "$(readlink -f "$0")")" || exit 1
inc=../notcoreutils
[ -f netmanager_blue.h ] && inc=.
mkdir -p bin
if [ ! -x bin/netmanager ] || [ netmanager.c -nt bin/netmanager ] || [ tui.h -nt bin/netmanager ] || [ "$inc/netmanager_blue.h" -nt bin/netmanager ]; then
	gcc -std=gnu11 -Wall -Wextra -O2 -I"$inc" -I. netmanager.c -o bin/netmanager
fi
exec bin/netmanager -tui
