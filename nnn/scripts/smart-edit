#!/usr/bin/env bash
# $EDITOR/$VISUAL wrapper: obrazy leca do mpv (podglad), reszta do emacsa.
# Uzywane przez nnn (klawisz 'e') - niezaleznie od git commit, ktore ma
# wlasny, blokujacy core.editor w .gitconfig (ten tu wraca od razu, zeby
# nnn zostawalo uzywalne, a nie czekalo az zamkniesz okno emacsa).

file="$1"
mime=$(file --mime-type -b "$file" 2>/dev/null)

case "$mime" in
    image/*)
        mpv --no-config "$file" &
        disown
        ;;
    *)
        emacs "$file" &
        disown
        ;;
esac
