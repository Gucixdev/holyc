.br
.B tree --ignore-case
.br
.B tree --filelimit n
.br
.B tree -p
.br
.B tree -u
.br
.B tree -g
.br
.B tree -s
.br
.B tree -h
.br
.B tree --si
.br
.B tree -D
.br
.B tree -F
.br
.B tree -i
.br
