# EXAMPLE only. On a systemd machine you would NOT run this: systemd-logind already owns org.freedesktop.login1.
# It exists for a VM or container with systemd as pid 1 but logind masked.
[Unit]
Description=qlogind (org.freedesktop.login1 subset)
After=dbus.service
Requires=dbus.service
Conflicts=systemd-logind.service

[Service]
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
ExecStart=/usr/bin/qlogind
Restart=on-failure

[Install]
WantedBy=multi-user.target
