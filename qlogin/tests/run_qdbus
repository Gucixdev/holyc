#!/usr/bin/env bash
# build + run the wire-library test against a private session bus used as the fake system bus
set -eu
cd "$(dirname "$(readlink -f "$0")")"
mkdir -p ../bin
nice -n 19 gcc -std=gnu11 -Wall -Wextra -O1 -g -fsanitize=address,undefined qdbus_test.c -o ../bin/qdbus_test
out=$(mktemp); dbus-daemon --session --print-address --fork --print-pid > "$out"
addr=$(sed -n 1p "$out"); pid=$(sed -n 2p "$out"); rm -f "$out"
trap 'kill "$pid" 2>/dev/null || true' EXIT
QD_TEST_BUS="$addr" ../bin/qdbus_test
