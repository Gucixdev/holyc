#!/usr/bin/env bash
# leaninit - start a project's lean4/ folder on the shared library in holyc/lean4: Lean 4.26 with the holyc package
# as its one dependency (core Lean, builds in seconds; add Mathlib to lakefile.lean when a proof needs it), a root module, a three-line axiom audit, a run that is a list of lib.sh steps, a README.
#
#   tools/leaninit PROJECT [LIB]    PROJECT/lean4 with the library LIB (default: PROJECT, capitalised)
#
# Writes lean-toolchain, lakefile.lean, .gitignore, LIB.lean, Audit.lean, run and README.md, then runs lake update
# for the manifest; refuses when PROJECT/lean4 exists. lean4/run builds, audits (every theorem of the LIB modules
# on propext, Classical.choice and Quot.sound only) and scans the sources for sorry, admit, native_decide, bv_decide
# and axiom declarations. PROJECT is a folder at holyc's top level.
# Example: tools/leaninit gtop
set -euo pipefail

proj=${1:?usage: tools/leaninit PROJECT [LIB]}
[[ -d $proj ]] || { echo "leaninit: no folder $proj" >&2; exit 2; }
lib=${2:-$(tr '[:lower:]' '[:upper:]' <<< "${proj:0:1}")${proj:1}}
[[ $lib =~ ^[A-Z][A-Za-z0-9]*$ ]] || { echo "leaninit: $lib is not a Lean module name" >&2; exit 2; }
out=$proj/lean4
[[ -e $out ]] && { echo "leaninit: $out exists already" >&2; exit 1; }
mkdir -p "$out"

echo 'leanprover/lean4:v4.26.0' > "$out/lean-toolchain"
printf '.lake/\n.lake-build.log\n.lake-audit.log\n.lake-oracle.log\n' > "$out/.gitignore"

cat > "$out/lakefile.lean" <<EOF
import Lake
open Lake DSL

/- Core Lean only, so a build takes seconds. When a proof needs Mathlib, add it to the lakefile:
   require mathlib from git "https://github.com/leanprover-community/mathlib4.git" @ "v4.26.0" -/
require holyc from "../../lean4"

package «${proj}_lean» where
  leanOptions := #[⟨\`autoImplicit, false⟩]

@[default_target]
lean_lib «${lib}» where
  roots := #[\`${lib}]
EOF

cat > "$out/$lib.lean" <<EOF
/- ${lib}: the Lean model of ${proj}'s C code and the proofs about it. Each module models one C file and names the
   functions it follows; this root imports them all, and Audit.lean checks every theorem they hold. -/
EOF

cat > "$out/Audit.lean" <<EOF
import Holyc.Audit
import ${lib}

#audit_axioms ${lib}
EOF

cat > "$out/run" <<'EOF'
#!/usr/bin/env bash
# lean4/run - build the proofs, audit their axioms, scan the sources for escape hatches; exit 0 when all pass. The
# steps are in ../../lean4/lib.sh; a differential test against the C code adds diff_test and mutant lines (see
# base/lean4/run).
. "$(dirname "$0")/../../lean4/lib.sh" || exit 2
lean_build
lean_audit
lean_scan
lean_end
EOF
chmod +x "$out/run"

cat > "$out/README.md" <<EOF
# lean4 - ${proj}, machine-checked

Lean 4 proofs about ${proj}'s C code: a Lean model of each C function, theorems about the model, and a test that
holds the C code to the model. The shared parts (the audit command, bit lemmas, the oracle driver, the run steps)
are in [holyc/lean4](../../lean4/README.md); [base/lean4](../../base/lean4/README.md) shows a full differential
test on them.

## Status

Nothing is proved yet: the folder builds, and the audit and the source scan pass on an empty library.

## Run

\`\`\`sh
${proj}/lean4/run     # build, axiom audit, source scan (needs elan; core Lean only, no Mathlib)
\`\`\`
EOF
if command -v lake > /dev/null || [[ -x $HOME/.elan/bin/lake ]]; then
    (cd "$out" && PATH="$HOME/.elan/bin:$PATH" lake update > /dev/null 2>&1) || echo "leaninit: lake update failed in $out" >&2
else echo "leaninit: no lake here; run lake update in $out before lean4/run" >&2; fi
echo "leaninit: $out ($lib)"
