#!/usr/bin/env bash
# leaninit - start a project's lean4/ folder the way vecindex/lean4 is laid out: Lean 4.26 with no dependencies
# (core Lean builds in seconds; add Mathlib to lakefile.lean when a proof needs it, as vecindex does), a root module,
# the axiom audit, a run script and a README to fill in.
#
#   tools/leaninit PROJECT [LIB]    PROJECT/lean4 with the library LIB (default: PROJECT, capitalised)
#
# Writes lean-toolchain, lakefile.lean, .gitignore, LIB.lean, Audit.lean, run and README.md; refuses when
# PROJECT/lean4 exists. lean4/run builds, audits (every theorem of the LIB modules on propext, Classical.choice
# and Quot.sound only) and scans the sources for sorry, admit, native_decide, bv_decide and axiom declarations.
# Example: tools/leaninit gtop
set -euo pipefail

proj=${1:?usage: tools/leaninit PROJECT [LIB]}
[[ -d $proj ]] || { echo "leaninit: no folder $proj" >&2; exit 2; }
lib=${2:-$(tr '[:lower:]' '[:upper:]' <<< "${proj:0:1}")${proj:1}}
[[ $lib =~ ^[A-Z][A-Za-z0-9]*$ ]] || { echo "leaninit: $lib is not a Lean module name" >&2; exit 2; }
out=$proj/lean4
[[ -e $out ]] && { echo "leaninit: $out exists already" >&2; exit 1; }
mkdir -p "$out"

echo 'leanprover/lean4:v4.26.0' > "$out/lean-toolchain"
printf '.lake/\n.lake-build.log\n.lake-audit.log\n' > "$out/.gitignore"

cat > "$out/lakefile.lean" <<EOF
import Lake
open Lake DSL

/- Core Lean only, so a build takes seconds. When a proof needs Mathlib, add it the way vecindex/lean4 does:
   require mathlib from git "https://github.com/leanprover-community/mathlib4.git" @ "v4.26.0" -/
package «${proj}_lean» where
  leanOptions := #[⟨\`autoImplicit, false⟩]

@[default_target]
lean_lib «${lib}» where
  roots := #[\`${lib}]
EOF

cat > "$out/$lib.lean" <<EOF
/- ${lib}: the Lean model of ${proj}'s C code and the proofs about it. Each module models one C file and names the
   functions it follows; this root imports them all, and Audit.lean checks every theorem they hold. -/
EOF

cat > "$out/Audit.lean" <<EOF
/-
  The axiom audit of \`run\`: every theorem of the \`${lib}\` modules - written in the sources or generated by Lean
  there - may rest on \`propext\`, \`Classical.choice\` and \`Quot.sound\` only: no \`sorry\`, no \`native_decide\` or
  \`bv_decide\` (\`Lean.ofReduceBool\`, \`Lean.trustCompiler\`), no axiom of a library. Theorems are selected by the
  module that defines them, so one in another namespace is audited too.
-/
import Lean
import ${lib}

open Lean Elab Command

#eval show CommandElabM Unit from do
  let env ← getEnv
  let allowed : Array Name := #[\`\`propext, \`\`Classical.choice, \`\`Quot.sound]
  let mut count := 0
  let mut written := 0
  let mut bad : Array (Name × Name) := #[]
  for (name, ci) in env.constants.toList do
    let some i := env.getModuleIdxFor? name | continue
    unless (\`${lib}).isPrefixOf env.header.moduleNames[i.toNat]! do continue
    if let .thmInfo _ := ci then
      count := count + 1
      if (← findDeclarationRanges? name).isSome then written := written + 1
      for a in ← liftCoreM (collectAxioms name) do
        unless allowed.contains a do bad := bad.push (name, a)
  if bad.isEmpty then
    logInfo m!"axiom audit: {count} theorems ({written} written in the sources, {count - written} generated by Lean), none rests on more than propext, Classical.choice, Quot.sound"
  else
    throwError m!"axiom audit: {bad.size} theorems rest on other axioms: {bad.toList}"
EOF

cat > "$out/run" <<'EOF'
#!/usr/bin/env bash
# lean4/run - build the proofs, audit their axioms, scan the sources for escape hatches; exit 0 when all pass.
# Needs elan with the toolchain in lean-toolchain. A differential test against the C code goes below once an
# oracle exists (vecindex/lean4/run is the pattern: the Lean definitions run as an exe, a C harness runs the
# real functions, their outputs compared on every input or on seeded random ones).
set -uo pipefail
cd "$(dirname "$0")" || exit 2
export PATH="$HOME/.elan/bin:$PATH"
fail=0
step() { printf '  %-4s %s\n' "$1" "$2"; [[ $1 == ok ]] || fail=1; }
if lake build > .lake-build.log 2>&1; then step ok "lake build: $(grep -oE '[0-9]+ jobs' .lake-build.log | tail -1)"
else tail -20 .lake-build.log; step FAIL "lake build"; fi
if lake env lean Audit.lean > .lake-audit.log 2>&1 && grep -q 'none rests' .lake-audit.log; then
    step ok "$(grep -oE 'axiom audit: [0-9]+ theorems \([0-9]+ written' .lake-audit.log) in the sources)"
else cat .lake-audit.log; step FAIL "axiom audit"; fi
if grep -rnE '\b(sorry|admit|native_decide|bv_decide)\b|^[[:space:]]*axiom ' --include=*.lean --exclude=Audit.lean \
        --exclude-dir=.lake .; then step FAIL "source scan"
else step ok "source scan: no sorry, admit, native_decide, bv_decide or axiom"; fi
exit "$fail"
EOF
chmod +x "$out/run"

cat > "$out/README.md" <<EOF
# lean4 - ${proj}, machine-checked

Lean 4 proofs about ${proj}'s C code: a Lean model of each C function, theorems about the model, and a test that
holds the C code to the model. The method is the one [vecindex/lean4](../../vecindex/lean4/README.md) uses.

## Status

Nothing is proved yet: the folder builds, and the audit and the source scan pass on an empty library.

## Run

\`\`\`sh
${proj}/lean4/run     # build, axiom audit, source scan (needs elan; core Lean only, no Mathlib)
\`\`\`
EOF
echo "leaninit: $out ($lib)"
