/-
  The axiom audit of `run`: every theorem of the `Vecindex` modules - the ones written in the sources and the ones
  Lean generates there (equation lemmas, the proof parts of definitions, the equation lemmas of TrustLean's evaluator
  that the proofs unfold) - may rest on `propext`, `Classical.choice` and `Quot.sound` only. That rules out `sorry`
  (`sorryAx`), `native_decide` and `bv_decide` (`Lean.ofReduceBool` and `Lean.trustCompiler`, which trust the
  compiler) and any axiom of a library, AMO-Lean's eight Radix-4 NTT axioms among them. Checked with
  `lake env lean Audit.lean`; an offending theorem makes it fail. Theorems are selected by the module that defines
  them, not by their name, so a theorem in another namespace is audited too.
-/
import Vecindex

open Lean Elab Command

#eval show CommandElabM Unit from do
  let env ← getEnv
  let allowed : Array Name := #[``propext, ``Classical.choice, ``Quot.sound]
  let mut count := 0
  let mut written := 0
  let mut bad : Array (Name × Name) := #[]
  for (name, ci) in env.constants.toList do
    let some i := env.getModuleIdxFor? name | continue
    unless (`Vecindex).isPrefixOf env.header.moduleNames[i.toNat]! do continue
    if let .thmInfo _ := ci then
      count := count + 1
      if (← findDeclarationRanges? name).isSome then written := written + 1
      for a in ← liftCoreM (collectAxioms name) do
        unless allowed.contains a do bad := bad.push (name, a)
  if bad.isEmpty then
    logInfo m!"axiom audit: {count} theorems ({written} written in the sources, {count - written} generated by Lean), none rests on more than propext, Classical.choice, Quot.sound"
  else
    throwError m!"axiom audit: {bad.size} theorems rest on other axioms: {bad.toList}"
