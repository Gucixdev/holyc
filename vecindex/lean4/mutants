#!/usr/bin/env bash
# mutants - does the differential test catch a wrong kernel? Each mutant is one small change to a copy of ../src (the
# real tree is not touched); the harness is rebuilt against the copy and the step that covers the kernel must fail.
#   lean4/mutants          every mutant; exit 0 when each one was caught
# Needs a previous lean4/run (the oracle binary and its tables in .build/out).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
ORACLE=.lake/build/bin/vecindex-oracle
[[ -x $ORACLE ]] || { echo "mutants: run lean4/run first" >&2; exit 2; }
CFLAGS=(-std=c89 -pedantic -Wall -Wextra -Werror -D_POSIX_C_SOURCE=200112L -O2 -Igen)
tmp=$(mktemp -d)
trap 'rm -rf -- "$tmp"' EXIT
missed=0

# name @ file @ sed expression @ arch @ check (a table name, a random-case name, or props) @ caught or survives
# A mutant marked "survives" changes code that the inputs of the C code never reach: the run proves that it stays
# unreached rather than missed.
mutants=(
"AVX2 fold: a1 << 7 instead of << 8@tq_scan.c@s/_mm_slli_epi16(x1, 8)/_mm_slli_epi16(x1, 7)/@haswell@block@caught"
"AVX-512 odd rows shifted by 7@tq_scan.c@s/A1 = _mm512_add_epi16(A1, _mm512_srli_epi16(r0, 8));/A1 = _mm512_add_epi16(A1, _mm512_srli_epi16(r0, 7));/@native@block@caught"
"scalar kernel: row 16 reads the low half@tq_scan.c@s/u8 c = j < 16 ? (u8)(byte \& 15) : (u8)(byte >> 4);/u8 c = j < 17 ? (u8)(byte \& 15) : (u8)(byte >> 4);/@x86-64@block@caught"
"gf_invert_ skips row 0 in the elimination@store_sum.c@s/if (r == c [|][|] !(f = a\[r \* n + c\])) continue;/if (r == c || r == 0 || !(f = a[r * n + c])) continue;/@native@props@caught"
"gf_invert_ without the row swap (a Cauchy matrix never needs one: its leading minors are nonzero)@store_sum.c@s/if (r != c) for (j = 0; j < n; ++j) {/if (0) for (j = 0; j < n; ++j) {/@native@props@survives"
"GF(2^8) polynomial 0x11b@store_sum.c@s/x ^= 0x11du;/x ^= 0x11bu;/@native@gf@caught"
"CRC-32C table polynomial off by one bit@store_batch.c@s/0x82f63b78u/0x82f63b79u/@x86-64@crc@caught"
"CRC-32C SSE4.2 path skips the last byte@store_batch.c@s/while (n--) crc = _mm_crc32_u8(crc, \*p++);/while (n-- > 1) crc = _mm_crc32_u8(crc, *p++);/@native@crc@caught"
"tq_code_ compares >= at step 3@tq.c@s/c += (v > TQ_B\[c + 1\]) << 1;/c += (v >= TQ_B[c + 1]) << 1;/@x86-64@props@caught"
"top-k breaks ties the other way@core.c@0,/while (j > 0 \&\& sc\[j - 1\] < sc\[j\])/s//while (j > 0 \&\& sc[j - 1] <= sc[j])/@native@topk@caught"
"2-bit column count not even@tq.c@s/((dpad \/ 2) + 1) \& ~1/((dpad \/ 2) + 1)/@native@vd@caught"
"layout: one parity block too few@store_sum.c@s/z->P = z->G \* m;/z->P = z->G * m - (m > 0);/@native@layout@caught"
"Walsh-Hadamard chunk: largest power not taken@tq.c@s/for (len = 1; len \* 2 <= dpad; len \*= 2) {}/for (len = 1; len * 4 <= dpad; len *= 2) {}/@x86-64@chunks@caught"
"rebuild uses the wrong parity row@store_sum.c@s/gf_coef_(k, use\[q\], md\[p\])/gf_coef_(k, use[q] + 1, md[p])/@native@props@caught"
"vs_in_ takes id 2^44 - 1 as outside@vserv_keys.c@s/if (\*id < 0 [|][|] \*id > VS_TMASK) return -1;/if (*id < 0 || *id >= VS_TMASK) return -1;/@native@tenant@caught"
"vs_rin_ clips a negative low end to 1@vserv_keys.c@s/if (\*lo < 0) \*lo = 0;/if (*lo < 0) *lo = 1;/@native@tenant@caught"
"vs_own_ drops the top bit of the wire id@vserv_keys.c@s/    \*id \&= VS_TMASK;/    *id \&= VS_TMASK >> 1;/@native@tenant@caught"
"key file: tenant 524287 refused@vserv_keys.c@s/if (i < tl [|][|] n < 1 [|][|] n > VS_TMAXN) {/if (i < tl || n < 1 || n >= VS_TMAXN) {/@native@tenant@caught"
"replica walk: a frame's CRC not checked@vserv_repl.c@s/if (store_crc32c_(g, n) != vs_le32_(fh + 5)) break;/if (0) break;/@native@journal@caught"
"replica walk: the header's CRC not checked@vserv_repl.c@s/store_crc32c_(h + 4, 12) == vs_le32_(h + 16)/1/@native@journal@caught"
"replica walk: a length past STORE_BATCH_MAX taken (only a journal past 1 GB holds such a frame whole; in the test files the bytes run out first, the same stop)@vserv_repl.c@s/if ((size_t)n > STORE_BATCH_MAX) break;/if (0) break;/@native@journal@survives"
"bucket: never above qps + 1 instead of qps@vserv_keys.c@s/if (\*tokens > qps) \*tokens = qps;/if (*tokens > qps + 1.0) *tokens = qps + 1.0;/@native@rate@caught"
"namespace set: the probe one to the right@tq.c@s/b += (b\[h - 1\] < v) ? h : 0;/b += (b[h] < v) ? h : 0;/@native@nsset@caught"
"namespace set: <= instead of <@tq.c@s/b += (b\[h - 1\] < v) ? h : 0;/b += (b[h - 1] <= v) ? h : 0;/@native@nsset@caught"
"bucket: a request needs more than one token@vserv_keys.c@s/ok = \*tokens >= 1.0;/ok = *tokens > 1.0;/@native@rate@caught"
)

for row in "${mutants[@]}"; do
    IFS='@' read -r name file expr arch check expect <<< "$row"
    d=$(mktemp -d -p "$tmp")
    cp -r ../src "$d/src"
    sed -i "$expr" "$d/src/$file"
    if cmp -s "../src/$file" "$d/src/$file"; then echo "?? $name: the sed did not apply"; missed=1; continue; fi
    bin=$d/diff
    case $check in
        tenant|journal|rate) src=c/vsdiff.c; flags=(-std=c89 -pedantic -Wall -Wextra -Werror -O2 -DVSERV_NO_TLS) ;;
        *) src=c/diff.c; flags=("${CFLAGS[@]}") ;;
    esac
    if ! gcc "${flags[@]}" -I"$d/src" -march="$arch" "$src" -lm -lpthread -o "$bin" 2> "$d/cc.txt"; then
        echo "WRONG     (does not compile): $name"; missed=1; continue; fi
    caught=0
    case $check in
        gf|digits|vd|layout|chunks)
            "$ORACLE" "$check" > "$d/want"; "$bin" "$check" > "$d/got" || true
            cmp -s "$d/want" "$d/got" || caught=1 ;;
        crc|block|topk|nsset|tenant|journal|rate)
            "$bin" "cases-$check" 300 1 > "$d/in"
            "$ORACLE" "$check" < "$d/in" > "$d/want"; "$bin" "$check" < "$d/in" > "$d/got" || true
            cmp -s "$d/want" "$d/got" || caught=1 ;;
        props)
            "$bin" props 100 1 > "$d/got" 2>&1 || caught=1 ;;
    esac
    if [[ $caught == 1 && $expect == caught ]]; then echo "caught    ($check, -march=$arch): $name"
    elif [[ $caught == 0 && $expect == survives ]]; then echo "survives  ($check, -march=$arch): $name"
    else echo "WRONG     ($check, -march=$arch, expected $expect): $name"; missed=1; fi
done
exit $missed
